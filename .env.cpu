# CPU build. Use with:
#   docker compose --env-file .env.cpu up -d --build
# Values explained in docker-compose.yml.

DOCKER_RUNTIME=runc

LAYA_MODELS=english
# Don't commit a real token here: export LAYA_API_TOKEN in the shell (it
# wins over this file) or put it in a git-ignored .env and add
# `--env-file .env` after this one.
LAYA_API_TOKEN=
LAYA_JEV_COMPAT=true
# 1 on CPU: one forward pass already uses every core.
LAYA_MAX_CONCURRENT_PREDICTIONS=1

# Raise when LAYA_MODELS has more than one entry (~1GB each).
MEMORY_LIMIT=4g
