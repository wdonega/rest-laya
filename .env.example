# Copy to .env (git-ignored) on a host to set its build once; plain
# `docker compose up -d --build` then picks it up.

# CUDA host (NVIDIA GPU): layer the CUDA overlay on top of the base file.
# COMPOSE_FILE=docker-compose.yml:docker-compose.cuda.yml

# torch build: cpu (default), or the CUDA suffix matching the host driver
# (cu132 is the CUDA overlay's default).
# TORCH_VARIANT=cu132
