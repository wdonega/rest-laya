# Copy to .env (git-ignored) to configure this host once; plain
# `docker compose up -d --build` then picks it up. Anything left commented
# keeps the default from docker-compose.yml.

# Which service to run: cpu or cuda.
COMPOSE_PROFILES=cpu

# cuda only: the torch build's CUDA suffix, matching the host driver.
# TORCH_VARIANT=cu132

# App settings (explained in docker-compose.yml).
# LAYA_MODELS=english
# LAYA_API_TOKEN=
# LAYA_JEV_COMPAT=true
# LAYA_MAX_CONCURRENT_PREDICTIONS=1   # default: 1 on cpu, 4 on cuda
