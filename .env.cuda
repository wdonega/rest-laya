# CUDA build, e.g. the Jetson Orin (JetPack 7.2). Use with:
#   docker compose --env-file .env.cuda up -d --build
# Values explained in docker-compose.yml.

COMPOSE_PROFILES=cuda
# torch build's CUDA suffix, matching the host driver (cu132 = CUDA 13.2).
TORCH_VARIANT=cu132

LAYA_MODELS=english
# Don't commit a real token here: export LAYA_API_TOKEN in the shell (it
# wins over this file) or put it in a git-ignored .env and add
# `--env-file .env` after this one.
LAYA_API_TOKEN=
LAYA_JEV_COMPAT=true
# On GPU, a few in flight keep the device busy while others tokenize.
LAYA_MAX_CONCURRENT_PREDICTIONS=4
